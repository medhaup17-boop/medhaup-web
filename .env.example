# Copy to .env.local. Leave service keys blank until the accounts are configured.
# Read docs/cloudflare-clerk-setup.md for the complete fresh-install instructions.

# Single administrator: all three values are server-only.
# Run npm run admin:setup to generate these values in .env.local.
# It also writes .env.vercel.auth for Vercel import and .env.admin-credentials
# for private owner lookup. These generated files are ignored by Git.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vercel -> private D1 gateway. Use the same random secret in the Worker.
D1_GATEWAY_URL=
D1_GATEWAY_SECRET=

# R2 S3 credentials scoped to the staging and public assets buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=medhaup-staging
R2_PUBLIC_BUCKET=medhaup-assets
NEXT_PUBLIC_R2_PUBLIC_URL=

# Existing optional integrations
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_APP_STORE_URL=
AI_FEATURE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
